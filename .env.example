# Copy this file to `.env` and fill in the values from your Lovable Cloud
# backend settings. Do NOT commit the filled-in `.env`.

# Read by the browser Supabase client (compiled into the client bundle —
# only ever put browser-safe, publishable values here).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Server-side fallbacks used during SSR.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=

# NOTE: SUPABASE_SERVICE_ROLE_KEY is intentionally absent. No code path in this
# app needs it, and it must never be exposed to the browser.
